# Exemplo do /opt/ns-codex/api/.env (produção).
# Copiar para .env, ajustar, chmod 600. NUNCA commitar o .env real.

# ── Banco ─────────────────────────────────────────────────────────────────
# Credencial da APLICAÇÃO (nscodex_app). Não é dona das tabelas e não tem DDL —
# é o que faz a Row Level Security valer. Nunca ponha aqui a do migrator nem a
# do postgres: com credencial de dona, as políticas viram decoração.
DATABASE_URL=postgresql://nscodex_app:TROQUE@localhost:5432/nscodex

# ── CORS ──────────────────────────────────────────────────────────────────
# Em produção, o mesmo domínio do front. Vazio/ausente cai no default de
# desenvolvimento (localhost:8081), que em produção não serve para nada.
CORS_ORIGINS=https://nscodex.nstech.com.br

# ── Ainda não usados — entram no passo 3 (Entra ID + JWT) ─────────────────
# JWT_SECRET=
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
