# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase
# (Settings → API, no painel do Supabase). Use a chave "anon public" — nunca a
# "service_role". O arquivo .env não deve ser commitado (já está no .gitignore).

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA-CHAVE-ANON-PUBLIC
